{
    // https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // https://code.visualstudio.com/docs/python/debugging
            "name": "ESPHome Device Builder",
            "type": "debugpy",
            "justMyCode": false,
            "request": "launch",
            "module": "esphome_device_builder",
            "env": {
                "ESPHOME_DATA_DIR": "/cache/debug-data"
            },
            "args": [
                "--log-level",
                "debug",
                "--port",
                "6054",
                "/config"
            ]
        }
    ]
}