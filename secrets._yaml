# Replace substitutions and rename to secrets.yaml

wifi_ssid: "ssid"
wifi_password: "password"
wifi_domain: ".local"

# Generate with: python3 -c 'import base64, os; print(base64.b64encode(os.urandom(32)).decode())'
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Micro-Air EasyStart module BLE MACs, used by hvac-compressor-sensor.yaml.
# Discover your own with: uv run easystart-monitor --discover
easystart_downstairs_mac: "AA:BB:CC:DD:EE:01"
easystart_upstairs_mac: "AA:BB:CC:DD:EE:02"
